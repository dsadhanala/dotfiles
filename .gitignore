# ============================================================
# Defense-in-depth. Keep secret files OUT of the repo entirely;
# this list is a safety net, not the primary control.
# ============================================================

# Credentials / keys / tokens
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa*
id_ed25519*
*_rsa
*_ed25519
.git-credentials
.netrc
.vault-token
*.env
*.env.local
*token*
*secret*
*credential*
known_hosts

# ============================================================
# ALL corp/secret/machine-local files live in local/ — a single
# directory this PUBLIC repo never tracks. Manage it as a separate
# PRIVATE repo (e.g. Adobe internal git). See local/README.md.
# ============================================================
/local/

# Stray copies elsewhere (defense-in-depth)
.secrets
.localrc
.gitconfig.local

# ...but DO track the one safe public template (generic identity only)
!.gitconfig.local.template

# Provider/app auth state that must never be committed
**/gh/hosts.yml
**/gcloud/**
.gnupg/

# Machine-local noise
*history*
.DS_Store
*.log
*.bak
*.backup
*.backup.*
*.pre-scrub.*
*.tmp
.zcompdump*
